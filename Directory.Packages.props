<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build / SourceLink / versioning -->
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />

    <!-- Boutquin packages -->
    <PackageVersion Include="Boutquin.Domain" Version="[1.0.1]" />

    <!-- Microsoft.Extensions -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.FileExtensions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />

    <!-- Third-party runtime -->
    <PackageVersion Include="Polly" Version="8.9.1" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />

    <!-- Test-only -->
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <!-- Explicit stable transitive versions, qualified with the complete graph. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="11.0.0" />
    <PackageVersion Include="System.Diagnostics.EventLog" Version="10.0.14" />
    <PackageVersion Include="xunit.analyzers" Version="2.3.0" />
  </ItemGroup>
  <!-- Latest stable packages for the .NET 11 target, verified against NuGet.org on 2026-11-14. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageVersion Update="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <PackageVersion Update="Microsoft.Extensions.Caching.Abstractions" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Configuration.FileExtensions" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Update="Polly" Version="8.9.1" />
    <PackageVersion Update="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Update="Microsoft.Extensions.DependencyModel" Version="11.0.0" />
    <PackageVersion Update="System.Diagnostics.EventLog" Version="11.0.0" />
    <PackageVersion Update="xunit.analyzers" Version="2.3.0" />
  </ItemGroup>
</Project>
